node_modules/
.wrangler/
*.local
.env
dist/
# On ignore le CONTENU de .claude, pas le dossier : git n'entre pas dans un
# dossier exclu, et la ligne d'exception ci-dessous resterait sans effet.
.claude/*
!.claude/skills/
# … sauf les réglages partagés, qui décrivent l'outillage du dépôt et non
# l'état local d'une session.
!.claude/settings.json
# Générés par build-front.js (la CI les reconstruit avant chaque déploiement)
client-v2/front.js
admin-v2/front.js
